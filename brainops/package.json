{
  "name": "@titanops/brainops",
  "version": "0.1.0",
  "description": "TitanOps platform intelligence layer — LangGraph.js agent with CockroachDB persistent memory",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@langchain/langgraph": "0.2.36",
    "@langchain/langgraph-checkpoint-postgres": "0.1.2",
    "@langchain/core": "0.3.37",
    "@modelcontextprotocol/sdk": "1.11.0",
    "@aws-sdk/client-bedrock-runtime": "3.758.0",
    "@aws-sdk/client-secrets-manager": "3.758.0",
    "nats": "2.29.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "@types/pg": "8.11.11",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
